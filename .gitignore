# Read-only upstream reference checkouts, never committed
refs/

# Secrets used by the example configurations. ESPHome resolves !secret against
# the directory of the config being built, so every folder under examples/ ends
# up with its own secrets.yaml. The ** form covers examples/secrets.yaml too.
examples/**/secrets.yaml
secrets.yaml

# ESPHome build output
.esphome/
*.bin
*.elf

# Host simulator build output
tools/sim/build/
tools/sim/build-gallery/
tools/sim/out/

# Python
__pycache__/
*.pyc

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Snapshot harness build output
tools/snapshot/.esphome/
