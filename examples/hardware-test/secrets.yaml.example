# You do not need this file. The four hardware-test firmwares build and flash
# with no secrets at all: they carry no wifi credentials, no API encryption key
# and no OTA password, and the board is onboarded after flashing from its own
# access point or over Improv serial. See docs/HARDWARE-TESTING.md.
#
# This file exists only for the two optional blocks commented out in
# network.yaml. If you uncomment either of them, copy this to secrets.yaml in
# this folder and fill it in. Every secrets.yaml in the tree is gitignored.
#
# Generate a fresh API key with `openssl rand -base64 32`, or take the one Home
# Assistant offers when it adopts the device. The value below is a placeholder
# and is in the repository, so do not ship it.
api_encryption_key: "OkdDEZX6Zh0uD5ifCEuzOu9wswN3y1/GYuz2DNlOmlw="
ota_password: "your-ota-password"
