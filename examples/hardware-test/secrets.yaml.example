# Copy to secrets.yaml in this folder and fill in. secrets.yaml is gitignored.
#
# Generate a fresh API key with `openssl rand -base64 32`, or take the one
# Home Assistant offers when it adopts the device. The value below is a
# placeholder and is in the repository, so do not ship it.
wifi_ssid: "your-ssid"
wifi_password: "your-password"
ota_password: "your-ota-password"
api_encryption_key: "OkdDEZX6Zh0uD5ifCEuzOu9wswN3y1/GYuz2DNlOmlw="
